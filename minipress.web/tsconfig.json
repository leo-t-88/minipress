{
  "compilerOptions": {
    "target": "es2016",
    "module": "es6",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "rootDir": "./ts",
    "outDir": "./js",
    "noEmitOnError": true
  },
  "files" : [
    "ts/main.ts",
    "ts/config.ts",
    "ts/types.ts",
    "ts/api.ts",
    "ts/filters.ts",
    "ts/view.ts"
  ]
}
