{% extends 'layout.twig' %}
{% block title %} Créer un article {% endblock %}

{% block content %}
<h1>Créer un article</h1>

<form action="{{ url_for('create_article_post') }}" method="post">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <input type="text" id="titre" name="titre" value="{{ old.titre ?? '' }}" placeholder="Titre" required>
    </br>
    <textarea id="resume" name="resume" placeholder="Resumé (Markdown)">{{ old.resume ?? '' }}</textarea>
    </br>
    <textarea id="contenu" name="contenu" placeholder="Contenu (Markdown)"  required>{{ old.contenu ?? '' }}</textarea>
    </br>
    <select id="categorie_id" name="categorie_id">
        <option value="">-- Choisir une catégorie --</option>
        {% for cat in categories %}
            <option value="{{ cat.id }}" {% if old.categorie_id == cat.id %}selected{% endif %}>
                {{ cat.nom }}
            </option>
        {% endfor %}
    </select>
    </br>
    <button type="submit">Créer l'article</button>
</form>
{% endblock %}
