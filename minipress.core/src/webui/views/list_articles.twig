{% extends 'layout.twig' %}

{% block title %}MiniPress - Liste des Articles{% endblock %}

{% block content %}
    <h2>Tous les articles</h2>

    <p><a href="{{ url_for('form_article') }}" class="btn-add"> Créer un nouvel article</a></p>

    <form action="{{ url_for('liste_articles') }}" method="get" class="filter-form">
        <label for="filter_categorie">Filtrer par catégorie :</label>
        <select id="filter_categorie" name="categorie_id" onchange="this.form.submit()">
            <option value="">-- Toutes les catégories --</option>
            {% for cat in categories %}
                <option value="{{ cat.id }}" {% if current_categorie_id == cat.id %}selected{% endif %}>
                    {{ cat.nom }}
                </option>
            {% endfor %}
        </select>
        <button type="submit">Filtrer</button>
    </form>
    </br>

    {% if articles is empty %}
        <p>Aucun article ne correspond à cette catégorie ou aucun article n'a été publié.</p>
    {% else %}
        <ul class="articles-list">
            {% for article in articles %}
                <li>
                    <strong>{{ article.titre }}</strong> 
                    <span class="article-date">(Créé le : {{ article.date_creation }})</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <p><a href="{{ url_for('home') }}">Retour à l'accueil</a></p>
{% endblock %}