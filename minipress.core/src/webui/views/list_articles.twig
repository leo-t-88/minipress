{% extends 'layout.twig' %}

{% block title %}MiniPress - Liste des Articles{% endblock %}

{% block content %}
    <h2>Tous les articles</h2>

    <form action="{{ url_for('liste_articles') }}" method="get">
        <label for="filter_categorie">Filtrer par catégorie :</label>
        <select id="filter_categorie" name="categorie_id" onchange="this.form.submit()">
            <option value="">Toutes les catégories</option>
            {% for cat in categories %}
            <option value="{{ cat.id }}" {% if current_categorie_id == cat.id %}selected{% endif %}>
                {{ cat.nom }}
            </option>
            {% endfor %}
        </select>
    </form>
    {% if articles is empty %}
        <p>Aucun article ne correspond à cette catégorie ou aucun article n'a été publié.</p>
    {% else %}
        <ul class="article_list">
            {% for article in articles %}
                <li>
                    <strong>{{ article.titre }}</strong> 
                    <span>(Créé le : {{ article.date_creation }} par {{ article.auteur.nom }})</span>
                    {% if article.can_toggle %}
                    <form action="{{ url_for('article_toggle_publish', { id: article.id }) }}" method="post">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        {% if article.date_publication == null %}
                        <button type="submit">Publier l'article</button>
                        {% else %}
                        <button type="submit" class="warnbtn">Depublier l'article</button>
                        {% endif %}
                    </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <a href="{{ url_for('create_article') }}"><button>Créer un nouvel article</button></a>
{% endblock %}