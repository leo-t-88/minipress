{% extends 'layout.twig' %}

{% block title %}Créer une catégorie{% endblock %}

{% block content %}
    <h1>Créer une catégorie</h1>

    {% if error is defined %}
        <p>{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ url_for('create_categorie_post') }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <div>
            <label for="label">Nom de la catégorie</label>
            <input type="text" id="label" name="label" value="{{ old_label ?? '' }}" required>
        </div>

        <button type="submit">Créer</button>
    </form>
{% endblock %}
