<h1>MiniPress</h1>

{% if user %}
    <p>Bonjour {{ user.nom }}</p>
    {# <a href="{{ url_for('logout') }}">Déconnexion</a> #}
{% else %}
    <a href="{{ url_for('signin') }}">Se connecter</a>
{% endif %}

<ul>
    {% for item in menu %}
        <li><a href="{{ url_for(item.route) }}">{{ item.label }}</a></li>
    {% endfor %}
</ul>
