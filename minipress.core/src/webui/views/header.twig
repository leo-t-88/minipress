<h1>MiniPress</h1>

{% if user %}
<p>Bonjour {{ user.nom }}</p>
{% endif %}

<nav>
    <ul>
        {% if user %}
        {# <a href="{{ url_for('logout') }}">Déconnexion</a> #}
        {% else %}
        <li><a href="{{ url_for('signin') }}">Se connecter</a></li>
        {% endif %}
        {% for item in menu %}
        <li><a href="{{ url_for(item.route) }}">{{ item.label }}</a></li>
        {% endfor %}
    </ul>
</nav>
