<h1>MiniPress</h1>

{% if user %}
<p>Bonjour {{ user.nom|capitalize }}</p>
{% endif %}

<nav>
    <ul>
        {% if user %}
        <li><a href="{{ url_for('logout') }}">Déconnexion</a></li>
        {% else %}
        <li><a href="{{ url_for('signin') }}">Se connecter</a></li>
        {% endif %}
        {% for item in menu %}
        <li><a href="{{ url_for('item.route') }}">{{ item.label }}</a></li>
        {% endfor %}
    </ul>
</nav>
