{% extends 'layout.twig' %}
{% block title %} Créer un article {% endblock %}

{% block content %}
<h1>Créer un article</h1>

<form action="{{ url_for('form_article') }}" method="post">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <input type="text" id="titre" name="titre" value="{{ old.titre ?? '' }}" placeholder="Titre" required>
    </br>
    <textarea id="resume" name="resume" placeholder="Resumé">{{ old.resume ?? '' }}</textarea>
    </br>
    <textarea id="contenu" name="contenu" placeholder="Contenu"  required>{{ old.contenu ?? '' }}</textarea>
    </br>
    <button type="submit">Créer l'article</button>
</form>
{% endblock %}
